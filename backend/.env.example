# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to git (it's already in .gitignore).

PORT=4000
NODE_ENV=development

# The exact URL your frontend runs on. In dev this is Vite's default.
# In production this becomes your deployed frontend's Render URL.
CLIENT_URL=http://localhost:5173

# Local Postgres for development. In production, Render provides this
# automatically when you attach a Postgres instance to the web service.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/faj_prime_dev"

# Added in Section 5 (auth):
# Generate a real random secret with: openssl rand -base64 32
# Never reuse this value between projects, and never commit a real one.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email notifications (Contact form + Inspection bookings).
# Sign up free at https://resend.com, verify a sending domain (or use
# their onboarding@resend.dev test address for now), then paste your
# API key below. If left blank, emails are just logged to the console
# instead of sent — useful for local development.
RESEND_API_KEY=
EMAIL_FROM="FAJ Prime Estates <onboarding@resend.dev>"
# Where YOUR team receives contact form / inspection booking notifications:
ADMIN_NOTIFICATION_EMAIL=
