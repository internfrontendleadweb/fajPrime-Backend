# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to git (it's already in .gitignore).

PORT=4000
NODE_ENV=development

# The exact URL your frontend runs on. In dev this is Vite's default.
# In production this becomes your deployed frontend's Render URL.
CLIENT_URL=http://localhost:5173

# Added in Section 2 (database):
# DATABASE_URL=

# Added in Section 5 (auth):
# JWT_SECRET=
